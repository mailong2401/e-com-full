  @Column({ name: 'stock', type: 'int', default: 0 })
  stock!: number;

  @Column({ name: 'category', type: 'varchar', length: 100 })
  category!: string;

  @Column({ name: 'brand', type: 'varchar', length: 100, nullable: true })
