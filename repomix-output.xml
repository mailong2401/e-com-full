                {loading ? 'Đang xử lý...' : 'Đăng ký'}
              </Button>

              <Text size="2" color="gray" align="center">
                Đã có tài khoản?{' '}
                <a href="/login" style={{ fontWeight: 'bold', color: 'var(--accent-9)' }}>
                  Đăng nhập
                </a>
              </Text>
            </Flex>
