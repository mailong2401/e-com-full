                Đăng ký
              </Button>
            </Flex>
          </form>
        </Card>

        <Flex justify="center" mt="4" gap="1">
          <Text size="2" color="gray">Chưa có tài khoản?</Text>
          <Link href="/register" size="2" weight="bold">Đăng ký ngay</Link>
        </Flex>
      </Box>
    </Flex>
